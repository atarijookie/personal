# Postgres connection (used by sensor_tcp_ingest.py)
PGHOST=localhost
PGPORT=5432
PGUSER=sensors
PGPASSWORD=srosnes
PGDATABASE=sensors

# TCP server bind
LISTEN_HOST=0.0.0.0
LISTEN_PORT=22222
# Max seconds to wait for a client line; prevents one hung socket from blocking ingest
CLIENT_TIMEOUT=10

# Runtime paths (used by run_sensor_server.sh)
VENV_DIR=.venv
SERVER_SCRIPT=sensor_tcp_ingest.py
PID_FILE=sensor_tcp_ingest.pid
LOG_FILE=sensor_tcp_ingest.log

# Flask API server
API_SCRIPT=sensor_api_server.py
API_PID_FILE=sensor_api_server.pid
API_LOG_FILE=sensor_api_server.log
API_HOST=0.0.0.0
API_PORT=20000
API_THREADS=4

# Deye / Solarman logger (LAN protocol key; keep this file private)
LOGGER_IP=192.168.1.xx
LOGGER_SN=
LOGGER_PORT=8899
LOGGER_SLAVE_ID=1
LOGGER_SOCKET_TIMEOUT=5
SOLAR_POLL_INTERVAL_SEC=600
SOLAR_SCRIPT=solar_ingest.py
SOLAR_PID_FILE=solar_ingest.pid
SOLAR_LOG_FILE=solar_ingest.log
